# Copy to .env and adjust.
# Linux: loaded by deploy/ece-screen.service; manual: `set -a; . ./.env; set +a; make run`.
# Windows: loaded by scripts/windows/run.ps1 (and therefore run.bat).

# Target frame rate (positive integer, default 60)
FPS=60

# UI scale factor (number > 0, default 1.35). Auto-multiplied by screenH/1080
# so 4K (~2160p) gets roughly 2× the 1080p text size.
ZOOM=1.35

# raylib log verbosity: unset = warnings only, info = every file load, debug = everything
#RL_LOG=info

# First Flutter admin (Admins collection). Seeded only when Admins is empty.
# If unset, defaults are admin@ece.local / admin12345 — change after first login.
ECE_ADMIN_EMAIL=admin@ece.local
ECE_ADMIN_PASSWORD=admin12345
