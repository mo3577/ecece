# Copy to .env and adjust.
# Linux: loaded by deploy/ece-screen.service; manual: `set -a; . ./.env; set +a; make run`.
# Windows: loaded by scripts/windows/run.ps1 (and therefore run.bat).

# Target frame rate (positive integer, default 60)
FPS=60

# UI scale factor (number > 0, default 1.2)
ZOOM=1.2

# raylib log verbosity: unset = warnings only, info = every file load, debug = everything
#RL_LOG=info
